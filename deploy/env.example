# =============================================================================
# Agent Universe / gsn-daemon —— 容器部署环境变量示例
# -----------------------------------------------------------------------------
# 用法：复制为 deploy/.env（或各节点实际 env 文件），填入真实值后由
#   docker compose --env-file deploy/.env ... 注入；不要把填好值的 .env 提交。
# ⚠️ 本文件仅为模板占位，绝不能用于对外/生产部署。
# =============================================================================

# ---- 身份与数据目录 ---------------------------------------------------------
# 容器内固定设为 /data（compose 已通过 environment 注入）；命名卷挂载于此。
HOME=/data

# ---- REST 写门 ---------------------------------------------------------------
# 配置后，所有 POST/PUT/PATCH/DELETE 必须携带：
#   Authorization: Bearer <REST_BEARER_TOKEN>
# 未配置时，写接口默认 fail-closed（拒绝）。生产用高熵随机值，例如：
#   openssl rand -hex 32
REST_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# 仅在明确要放开写门（极不推荐对外暴露）时设为 1。默认不设。
# REST_ALLOW_UNAUTHENTICATED=1

# ---- 治理集（marketplace / 治理门写操作）------------------------------------
# JSON 文件路径，内容形如 deploy/governance.example.json：[{did, pubkey_hex}]。
# 未设置或为空 → 治理门写操作 fail-closed。不硬编码任何官方密钥，部署时由运维填入。
# GSN_GOVERNANCE_FILE=/data/governance.json

# ---- CRDT 持久化 -------------------------------------------------------------
# CRDT 状态快照落盘间隔（秒），默认 15。
GSN_CRDT_SNAPSHOT_INTERVAL_SECS=15

# ---- 健康检查 ---------------------------------------------------------------
# gsn-daemon --healthcheck 拉取的 URL（默认 http://127.0.0.1:4002/health，通常无需改）。
# GSN_HEALTHCHECK_URL=http://127.0.0.1:4002/health

# ---- 运行身份 ---------------------------------------------------------------
# 容器以 nonroot(uid 65532) 运行，非 root，无需此项。
# 仅当被迫以 root 运行时才设 GSN_ALLOW_ROOT=1（distroless 方案不建议）。
# GSN_ALLOW_ROOT=0
