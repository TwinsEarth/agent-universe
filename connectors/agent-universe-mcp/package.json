    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-universe",
    "gsn",
    "stdio",
    "streamable-http",
    "bridge"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/TwinsEarth/agent-universe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwinsEarth/agent-universe.git",
    "directory": "connectors/agent-universe-mcp"
  },
  "scripts": {
    "start": "node src/stdio.js",
    "test": "node --test test/*.test.js"
  }
}
