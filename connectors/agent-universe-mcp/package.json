{
  "name": "@twinsearth/agent-universe-mcp",
  "version": "3.5.0",
  "description": "Zero-dependency MCP stdio ↔ Streamable-HTTP bridge for the agent-universe gsn-daemon (/api/v1/mcp).",
  "type": "module",
  "main": "src/http-forward.js",
  "exports": {
    ".": "./src/http-forward.js",
    "./framing": "./src/framing.js",
    "./stdio": "./src/stdio.js"
  },
  "bin": {
