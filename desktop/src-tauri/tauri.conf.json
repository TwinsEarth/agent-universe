{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Universe Workbench",
  "version": "3.7.8",
  "identifier": "com.twinsearth.auworkbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Universe 工作台 v2.9.0",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
